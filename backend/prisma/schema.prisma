generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ReceiptStatus {
  PLANNED
  IN_TRANSIT
  RECEIVED
  CANCELED
}

model SKU {
  id                   String                @id @default(cuid())
  skuCode              String                @unique
  name                 String
  description          String?
  unit                 String                @default("EA")
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventoryAdjustments InventoryAdjustment[]
  inboundReceipts      InboundReceipt[]
  inventories          Inventory[]
}

model Warehouse {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  city                 String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventoryAdjustments InventoryAdjustment[]
  inboundReceipts      InboundReceipt[]
  inventories          Inventory[]
}

model Inventory {
  skuId            String
  warehouseId      String
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  safetyStock      Int      @default(0)
  updatedAt        DateTime @updatedAt

  sku       SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([skuId, warehouseId])
  @@index([warehouseId])
}

model InventoryAdjustment {
  id             String   @id @default(cuid())
  skuId          String
  warehouseId    String
  quantityChange Int
  reason         String
  createdAt      DateTime @default(now())

  sku       SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([skuId, warehouseId, createdAt])
}

model InboundReceipt {
  id                  String        @id @default(cuid())
  receiptId           String        @unique
  skuId               String
  warehouseId         String
  expectedArrivalTime DateTime
  quantity            Int
  status              ReceiptStatus @default(PLANNED)
  receivedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sku       SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([skuId, warehouseId, status])
  @@index([expectedArrivalTime])
}
